# ─────────────────────────────────────────────────────────────────────────────
# PhotoXo environment. Copy to `.env.local` for development.
# Production values live in Vercel → Project → Settings → Environment Variables.
# Never commit real credentials. All variables are server-only (no NEXT_PUBLIC_).
# Validated at startup by src/lib/env.schema.ts — the app refuses to boot if invalid.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
# Local: run `npm run dev:db` (replica set on 27017) and use the URI below.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=photoxo

# ── Authentication ──────────────────────────────────────────────────────────
# 32+ random characters:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: "Sign in with Google" for already-invited users (set both or neither).
# Authorized redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Application ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Required in production. In development, leave empty: emails (invitation
# links) are printed to the server console instead of being sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Media (Cloudinary) ──────────────────────────────────────────────────────
# Optional. Set all three or none. Without them, versions use external links only
# (Drive/Canva/Frame.io); with them, staff can upload files directly (stored as
# authenticated assets, delivered through short signed URLs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Internal ────────────────────────────────────────────────────────────────
# Shared secret for the scheduled-jobs endpoint GET/POST /api/jobs/tick
# (reminders, notification email delivery, notification retention). Call it
# every ~15 minutes with `Authorization: Bearer <CRON_SECRET>`. Required in
# production (24+ chars). Locally you may leave it empty and run
# `npm run jobs:tick` instead. Generate with: openssl rand -base64 32
CRON_SECRET=
