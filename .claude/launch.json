{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "photoxo-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "photoxo-dev-localdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "MONGODB_URI": "mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true",
        "MONGODB_DB_NAME": "photoxo_dev"
      },
      "port": 3000
    }
  ]
}
