{
  "name": "photoxo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "tsx --conditions=react-server scripts/ensure-indexes.ts",
    "create-admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "jobs:tick": "tsx --conditions=react-server scripts/jobs-tick.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.50.0",
    "mongodb": "7.6.0",
    "mongodb-connection-string-url": "7.0.2",
    "mongoose": "9.10.4",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
